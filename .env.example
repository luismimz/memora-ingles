# Variables para Coolify (o docker compose en local). Copia a .env y rellena.
APP_URL=https://ingles.luismontalvan.com
PUBLIC_URL=https://ingles.luismontalvan.com/api
DIRECTUS_SECRET=cambia-esto-openssl-rand-hex-32
ADMIN_EMAIL=tu-email@ejemplo.com
ADMIN_PASSWORD=una-contraseña-larga
DB_PASSWORD=otra-contraseña-larga
# IA (opcional pero recomendada): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
OPENROUTER_MODELS=deepseek/deepseek-chat-v3.1,google/gemini-2.5-flash,openai/gpt-4o-mini,anthropic/claude-haiku-4.5
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Proveedores intercambiables (ver backend/extensions/memora-ai/dist/providers/index.js)
LLM_PROVIDER=openrouter
PRONUNCIATION_PROVIDER=datamuse
CANDIDATES_PROVIDER=datamuse
IMAGE_PROVIDER=pollinations        # gratis; "openrouter" usa OPENROUTER_IMAGE_MODEL (de pago)
SENTENCES_PROVIDER=tatoeba
# Limita la IA (que cuesta dinero) a estos emails, separados por comas. Vacío = todos los registrados.
AI_ALLOWED_EMAILS=
# false = nadie más puede registrarse (crea las cuentas desde el panel de Directus)
PUBLIC_REGISTRATION=true
# Email para «¿Has olvidado la contraseña?» (cualquier SMTP: el de tu dominio, Brevo, Resend, Gmail con contraseña de aplicación…)
EMAIL_FROM=no-reply@luismontalvan.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false
